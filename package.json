{
  "name": "spite-and-spike",
  "private": true,
  "description": "Spite & Spike — 4v4 anime volleyball RPG (browser, no build step).",
  "scripts": {
    "test": "node tests/run.js",
    "test:update": "node tests/run.js --update",
    "lint": "eslint .",
    "format": "prettier --write \"js/**/*.{js,mjs}\" \"css/**/*.css\" \"tests/**/*.js\" \"*.html\"",
    "serve": "python3 -m http.server 8765",
    "format:check": "prettier --check \"js/**/*.{js,mjs}\" \"css/**/*.css\" \"tests/**/*.js\" \"*.html\"",
    "test:quick": "node tests/run.js --quick",
    "test:ui": "node tests/ui-smoke.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@pixiv/three-vrm": "3.5.5",
    "eslint": "^9.0.0",
    "espree": "^10.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "three": "0.169.0"
  }
}
